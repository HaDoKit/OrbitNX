{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/build.ps1"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "deploy",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/scripts/deploy.ps1"
            ],
            "problemMatcher": [],
            "dependsOn": "build"
        },
        {
            "label": "build+deploy",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command",
                "& '${workspaceFolder}/scripts/build.ps1'; if ($LASTEXITCODE -eq 0) { & '${workspaceFolder}/scripts/deploy.ps1' }"
            ],
            "problemMatcher": []
        }
    ]
}
