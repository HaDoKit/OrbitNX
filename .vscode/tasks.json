{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OrbitNX/OrbitNX.csproj",
                "/property:GenerateFullPaths=true",
                "/property:Configuration=Release",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "build-installer",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/OrbitNX/scripts/build-installer.ps1"
            ],
            "problemMatcher": []
        },
        {
            "label": "switch: build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/OrbitNX Client/OrbitNX/scripts/build.ps1"
            ],
            "problemMatcher": "$gcc"
        },
        {
            "label": "switch: deploy",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/OrbitNX Client/OrbitNX/scripts/deploy.ps1"
            ],
            "problemMatcher": [],
            "dependsOn": "switch: build"
        },
        {
            "label": "switch: build+deploy",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-Command",
                "& '${workspaceFolder}/OrbitNX Client/OrbitNX/scripts/build.ps1'; if ($LASTEXITCODE -eq 0) { & '${workspaceFolder}/OrbitNX Client/OrbitNX/scripts/deploy.ps1' }"
            ],
            "problemMatcher": []
        }
    ]
}
