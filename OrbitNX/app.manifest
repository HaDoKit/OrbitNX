<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Elevated by default: pnputil-based virtual controller device removal (see
    Input/VirtualGamepad.cs), ScpVBus IOCTLs, and relaunching Steam onto a hidden desktop all
    behave more reliably running as admin. Requiring it here means one UAC prompt at app startup
    instead of prompts scattered through the session (or silent no-ops without one).
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    DPI awareness is set via the OrbitNX.csproj "ApplicationHighDpiMode" property instead
    of here - the WinForms SDK analyzer (WFAC010) flags manifest-based DPI settings as deprecated
    for SDK-style WinForms projects and asks for the project-property/API form instead, which also
    avoids the two mechanisms silently conflicting with each other.
  -->
</assembly>
