<ui:FluentWindow x:Class="OrbitNX.UI.Library.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Игра" Width="720" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        Background="#FF0B0B14">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Игра" Height="42" Background="Transparent" Foreground="White"
                     ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" Margin="20,8,20,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Grid.Column="1" Padding="6" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Способ запуска" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="TypeCombo" Grid.Column="1" />
                    </Grid>

                    <!-- Обычная игра -->
                    <StackPanel x:Name="NativePanel">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Файл игры (.exe)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExePathBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseExeButton" Grid.Column="2" Content="Обзор…" Appearance="Secondary" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Аргументы" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ArgumentsBox" Grid.Column="1" Padding="6" />
                        </Grid>
                    </StackPanel>

                    <!-- Steam -->
                    <StackPanel x:Name="SteamPanel">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Установленные" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SteamGameCombo" Grid.Column="1" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Steam AppID" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SteamAppIdBox" Grid.Column="1" Padding="6" />
                        </Grid>
                    </StackPanel>

                    <!-- Эмулятор -->
                    <StackPanel x:Name="EmulatorPanel">
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Эмулятор (.exe)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="EmulatorPathBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseEmulatorButton" Grid.Column="2" Content="Обзор…" Appearance="Secondary" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Файл игры (ROM)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RomPathBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                            <ui:Button x:Name="BrowseRomButton" Grid.Column="2" Content="Обзор…" Appearance="Secondary" />
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Аргументы" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1">
                                <TextBox x:Name="ArgumentTemplateBox" Padding="6" />
                                <TextBlock Text="{}{rom} заменяется путём к файлу игры, например: -f -g &quot;{rom}&quot;"
                                           Foreground="#888888" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Скрипт -->
                    <StackPanel x:Name="ScriptPanel">
                        <TextBlock Text="Команды cmd (выполняются через cmd.exe, по одной на строку)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBox x:Name="ScriptBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 FontFamily="Consolas" MinHeight="140" Padding="6" Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <!-- Общие для обычной игры и скрипта -->
                    <Grid x:Name="WorkingDirRow" Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Рабочая папка" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WorkingDirBox" Grid.Column="1" Padding="6" Margin="0,0,8,0" />
                        <ui:Button x:Name="BrowseWorkingDirButton" Grid.Column="2" Content="Обзор…" Appearance="Secondary" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Геймпад" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ControllerCombo" Grid.Column="1" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Изображение" Style="{StaticResource FieldLabel}" />
                        <CheckBox x:Name="CaptureWindowCheck" Grid.Column="1" Foreground="White"
                                  ToolTip="Игра растягивается на экран Switch, даже если на PC она в окне. Снимите, если изображение чёрное — тогда будет показан весь монитор.">
                            <TextBlock Text="Показывать на Switch только окно игры" TextWrapping="Wrap" />
                        </CheckBox>
                    </Grid>
                </StackPanel>

                <!-- Обложка -->
                <StackPanel Grid.Column="1" Width="160">
                    <TextBlock Text="Обложка (2:3)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <Border Width="160" Height="240" CornerRadius="8" Background="#FF2A2A36" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="NoCoverText" Text="Нет обложки" Foreground="#777777"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <ui:Button x:Name="ChooseCoverButton" Content="Выбрать…" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <ui:Button x:Name="CropCoverButton" Content="Кадр…" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="0,6,0,0"
                               ToolTip="Выбрать, какая часть картинки будет обложкой на Switch" />
                    <ui:Button x:Name="ClearCoverButton" Content="Убрать" Appearance="Secondary"
                               HorizontalAlignment="Stretch" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <ui:Button x:Name="CancelButton" Content="Отмена" Appearance="Secondary" Margin="0,0,8,0" MinWidth="100" />
            <ui:Button x:Name="SaveButton" Content="Сохранить" Appearance="Primary" MinWidth="100" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
