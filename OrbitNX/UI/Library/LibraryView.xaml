<UserControl x:Class="OrbitNX.UI.Library.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BackButton" Appearance="Secondary" Margin="0,0,12,0" ToolTip="Назад">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button.Icon>
            </ui:Button>
            <TextBlock Grid.Column="1" Text="Библиотека игр" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            <ui:Button x:Name="AddButton" Grid.Column="2" Content="Добавить игру" Appearance="Primary">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyHint" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Библиотека пуста. Добавьте игры — они появятся на Switch в плитке «My games» главного меню." />
                <StackPanel x:Name="EntryList" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
